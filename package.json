{
  "name": "cypress",
  "version": "1.0.0",
  "description": "Cypress E2E Testing Project",
  "main": "index.js",
  "scripts": {
    "test": "cypress run",
    "test:open": "cypress open",
    "test:headless": "cypress run --headless",
    "test:chrome": "cypress run --browser chrome",
    "test:report": "cypress run --reporter mochawesome",
    "test:component": "cypress run --component",
    "test:component:open": "cypress open --component",
    "test:component:report": "cypress run --component --reporter mochawesome",
    "test:all": "npm run test && npm run test:component",
    "report:merge": "npx mochawesome-merge cypress/reports/*.json > cypress/reports/output.json",
    "report:generate": "npx marge cypress/reports/output.json -f report -o cypress/reports",
    "report:full": "npm run test:report && npm run report:merge && npm run report:generate",
    "clean:reports": "rimraf cypress/reports/*.json cypress/reports/*.html"
  },
  "keywords": [
    "cypress",
    "e2e",
    "testing",
    "automation"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@babel/core": "^7.27.7",
    "@babel/preset-env": "^7.27.2",
    "@babel/preset-react": "^7.27.1",
    "babel-loader": "^10.0.0",
    "css-loader": "^7.1.2",
    "cypress": "^13.6.0",
    "mochawesome": "^7.1.3",
    "mochawesome-merge": "^4.2.2",
    "mochawesome-report-generator": "^6.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "rimraf": "^6.0.1",
    "style-loader": "^4.0.0",
    "webpack": "^5.99.9",
    "webpack-cli": "^6.0.1"
  }
}
